--- a/src/stream.h
+++ b/src/stream.h
@@ -188,2 +188,14 @@ struct rig_stream

+/* Optional per-session external PCM producer. Install before serving
+ * clients, and keep its context alive until all streams have closed. */
+struct stream_rx_provider
+{
+    void *context;
+    int (*open)(void *context, struct rig_stream *stream);
+    void (*close)(void *context, struct rig_stream *stream);
+};
+
+int stream_set_rx_provider(RIG *rig, const struct stream_rx_provider *provider,
+                           const struct rig_stream_caps *caps);
+
 /* Per-rig streaming state (pointed to by rig_state.stream_state). */
@@ -209,2 +221,3 @@ struct rig_stream_state
     struct rig_stream_caps *session_caps;
+    struct stream_rx_provider rx_provider;
 };
